  shorttitle = {Social Welfare Matters},
  author = {O'Campo, Patricia and Molnar, Agnes and Ng, Edwin and Renahy, Emilie and Mitchell, Christiane and Shankardass, Ketan and St. John, Alexander and Bambra, Clare and Muntaner, Carles},
  year = {2015},
