  title = {State and {{Local Government Expenditures}} and {{Infant Mortality}} in the {{United States}}},
  author = {Goldstein, Neal D. and Palumbo, Aimee J. and Bellamy, Scarlett L. and Purtle, Jonathan and Locke, Robert},
  year = {2020},
  month = nov,
  journal = {Pediatrics},
  volume = {146},
