@article{lopez04,
  title = {Income Inequality and Self-Rated Health in {{US}} Metropolitan Areas: {{A}} Multi-Level Analysis},
  shorttitle = {Income Inequality and Self-Rated Health in {{US}} Metropolitan Areas},
  author = {Lopez, Russ},
  year = {2004},
