@article{leeChangingMarriagePatterns2010,
  title = {Changing {{Marriage Patterns Since}} 1970: {{What}}'s {{Going On}}, and {{Why}}?},
  shorttitle = {Changing {{Marriage Patterns Since}} 1970},
  author = {Lee, Gary R. and Payne, Krista K.},
  year = {2010},
  journal = {Journal of Comparative Family Studies},
  volume = {41},
