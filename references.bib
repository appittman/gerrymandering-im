  doi = {10.1177/0003122418794635},
  urldate = {2024-02-03},
  abstract = {Immigration scholars have increasingly questioned the idea that ``illegality'' is a fixed, inherent condition. Instead, the new consensus is that immigration laws produce ``illegality.'' But can ``illegality'' be socially constructed? When initially judging who is an ``illegal immigrant,'' common observers and even authorities typically do not rely on an individual's documentation. Instead, people rely on shared stereotypes to assign ``illegality'' to certain bodies, a condition we refer to as ``social illegality.'' Ethnographers have documented that individual traits like occupation or national-origin may trigger illegality suspicions, but it is not clear how widespread these stereotypes are, or whether all stereotypes are equally consequential. To address this question, we examine the personal attributes shaping perceived ``illegality.'' We apply a paired conjoint survey experiment on a nationally representative sample of 1,515 non-Hispanic white U.S. adults to assess the independent effect of each dimension. We find that national origin, social class, and criminal background powerfully shape perceptions of illegality. These findings reveal a new source of ethnic-based inequalities---``social illegality''---that may potentially increase law enforcement scrutiny and influence the decisions of hiring managers, landlords, teachers, and other members of the public.},
  langid = {english},
  file = {/Users/ameliapittman/Zotero/storage/5M8FQYQX/Flores and Schachter - 2018 - Who are the “Illegals” The Social Construction of.pdf}
}

@article{ford21,
  title = {Gerrymanders: {{How Redistricting Has Protected Slavery}}, {{White Supremacy}}, and {{Partisan Minorities}} in {{Virginia}}},
  shorttitle = {Gerrymanders},
  author = {Ford, Charles H},
  year = {2021},
  month = mar,
  journal = {Journal of American History},
  volume = {107},
  number = {4},
  pages = {977--978},
  issn = {0021-8723},
  doi = {10.1093/jahist/jaaa535},
  urldate = {2023-05-01},
  abstract = {Redistricting seems to be an ingrained strategy of American partisan politics, a decennial ritual practiced by both major political parties to gain electoral advantage. Brent Tarter's concise tracing of the history of partisan redistricting, or gerrymandering, in Virginia shows how incumbent elites from the beginning tried to tailor their electorate to protect their political power and economic interests, from slavery and secession, through the Jim Crow regime of the Byrd machine, to the maintenance of conservative and wealthy whites in office amid rapidly changing demographics today.For example, the 1817 tax law that seemed on the surface to extend more senatorial representation for the developing western frontier also perpetuated the persistent overrepresentation of propertied slaveholders from the eastern and southeastern parts of the state. The great gerrymander of 1830, which gave tidewater and southside planters permanent majorities in both houses of Virginia's General Assembly, was ``revised and disguised'' in the fitting words of the author by the seemingly more egalitarian constitution of 1851 (p. 29). With that document, universal manhood suffrage for white men, more elections for more offices, and the abolition of taxation requirements for voting masked the invention of district lines that continued to give eastern slaveholders ample security in their hold on government. The Civil War, with the West Virginia secession and emancipation of slaves, made disfranchisement of newly freed slaves and/or poor whites the preferred way of electorally privileging the already privileged. The population increases in Virginian cities and suburbs during the twentieth century, though, knocked the relatively stable districting that had favored rural and agricultural interests out of alignment with voter trends. Along with disfranchisement, malappropriation of seats made it easy for Harry Flood Byrd and his political machine to guarantee their candidates' successes in lieu of primaries and caucuses. After the end of the local poll tax in 1966, gerrymandering reemerged as the preferred way of keeping white oligarchies in charge, despite the Supreme Court's embrace of the one-man one-vote ideal in Baker v. Carr (1962). The courts quickly applied the new standards to Virginia's outdated districting and found wide variations in populations between adjacent districts. These problems as well as the concerns of the national Voting Rights Act (1965) about the manipulation of African American voters drove the redrawing of legislative lines in the late twentieth century in a relatively more egalitarian direction. Polarization of the political parties, though, from the 1990s to the present has once again spurred gerrymandering techniques such as concentrating African American Democrats in one district while increasing the chances for a deeply conservative Republican representative in a neighboring county. In this dystopian scenario, the center fails to hold, with only the reliable cores of both sides winning elections and providing thus little serious primary competition for incumbents.},
  file = {/Users/ameliapittman/Zotero/storage/SQYLS368/Ford - 2021 - Gerrymanders How Redistricting Has Protected Slav.pdf;/Users/ameliapittman/Zotero/storage/NM7ICE56/6157218.html}
}

