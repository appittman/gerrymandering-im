@article{tran_etal23,
  title = {State-Level Heterogeneity in Associations between Structural Stigma and Individual Health Care Access: {{A}} Multilevel Analysis of Transgender Adults in the {{United States}}},
  shorttitle = {State-Level Heterogeneity in Associations between Structural Stigma and Individual Health Care Access},
  author = {Tran, Nguyen K and Baker, Kellan E and Lett, Elle and Scheim, Ayden I},
  year = {2023},
