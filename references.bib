@article{tebbe_etal22,
  title = {A Dangerous Visibility: {{Moderating}} Effects of Antitrans Legislative Efforts on Trans and Gender-Diverse Mental Health},
  shorttitle = {A Dangerous Visibility},
  author = {Tebbe, Elliot A. and Simone, Melissa and Wilson, Emily and Hunsicker, Madeline},
