@article{misra_etal21,
  title = {Structural {{Racism}} and {{Immigrant Health}} in the {{United States}}},
  author = {Misra, Supriya and Kwon, Simona C. and {Abra{\'i}do-Lanza}, Ana F. and Chebli, Perla and {Trinh-Shevrin}, Chau and Yi, Stella S.},
  year = {2021},
