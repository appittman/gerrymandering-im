@article{jackson_etal10,
  title = {Race and {{Unhealthy Behaviors}}: {{Chronic Stress}}, the {{HPA Axis}}, and {{Physical}} and {{Mental Health Disparities Over}} the {{Life Course}}},
  shorttitle = {Race and {{Unhealthy Behaviors}}},
  author = {Jackson, James S. and Knight, Katherine M. and Rafferty, Jane A.},
  year = {2010},
